{%- comment -%}
  main-cart.liquid
  Página de carrinho com items + resumo lateral.
{%- endcomment -%}

<section class="vf-cart">
  <div class="vf-container">
    <header class="vf-cart__header">
      <h1>Seu carrinho</h1>
      {%- if cart.item_count > 0 -%}
        <p class="vf-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</p>
      {%- endif -%}
    </header>

    {%- if cart.item_count == 0 -%}
      <div class="vf-cart__empty">
        <div class="vf-cart__empty-icon" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h2>Seu carrinho está vazio</h2>
        <p>Adicione um protocolo e comece sua jornada com o corpo limpo de dentro pra fora.</p>
        <a href="{{ routes.root_url }}" class="vf-button vf-button--primary vf-button--lg">
          Ver protocolos
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="vf-cart__form" data-vf-cart-form novalidate>
        <div class="vf-cart__layout">

          {%- comment -%} Lista de items {%- endcomment -%}
          <div class="vf-cart__items">
            {%- for item in cart.items -%}
              <article class="vf-cart-item" data-cart-item data-key="{{ item.key }}">
                <a href="{{ item.url }}" class="vf-cart-item__image">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 200 }}"
                      alt="{{ item.image.alt | escape | default: item.title }}"
                      width="200"
                      height="200"
                      loading="lazy">
                  {%- endif -%}
                </a>

                <div class="vf-cart-item__body">
                  <a href="{{ item.url }}" class="vf-cart-item__title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' and item.product.has_only_default_variant == false -%}
                    <span class="vf-cart-item__variant">{{ item.variant.title }}</span>
                  {%- endif -%}
                  <div class="vf-cart-item__price-mobile">{%- if item.original_line_price > item.final_line_price -%}<s class="vf-cart-item__was">{{ item.original_line_price | money }}</s><span class="vf-cart-item__now">{{ item.final_line_price | money }}</span>{%- else -%}{{ item.final_line_price | money }}{%- endif -%}</div>
                </div>

                <div class="vf-cart-item__qty">
                  <div class="vf-cart-item__qty-control">
                    <button
                      type="button"
                      class="vf-cart-item__qty-btn"
                      data-cart-qty-decrease
                      data-key="{{ item.key }}"
                      aria-label="Diminuir quantidade">
                      {% render 'icon-minus' %}
                    </button>
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      max="99"
                      class="vf-cart-item__qty-input"
                      data-cart-qty-input
                      data-key="{{ item.key }}"
                      aria-label="Quantidade">
                    <button
                      type="button"
                      class="vf-cart-item__qty-btn"
                      data-cart-qty-increase
                      data-key="{{ item.key }}"
                      aria-label="Aumentar quantidade">
                      {% render 'icon-plus' %}
                    </button>
                  </div>
                </div>

                <div class="vf-cart-item__price">{%- if item.original_line_price > item.final_line_price -%}<s class="vf-cart-item__was">{{ item.original_line_price | money }}</s><span class="vf-cart-item__now">{{ item.final_line_price | money }}</span>{%- else -%}{{ item.final_line_price | money }}{%- endif -%}</div>

                <a href="{{ item.url_to_remove }}" class="vf-cart-item__remove" data-cart-remove data-key="{{ item.key }}" aria-label="Remover {{ item.product.title }} do carrinho">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </a>
              </article>
            {%- endfor -%}
          </div>

          {%- comment -%} Resumo {%- endcomment -%}
          <aside class="vf-cart__summary">
            <h2 class="vf-cart__summary-title">Resumo</h2>

            <div class="vf-cart__summary-row">
              <span>Subtotal</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            {%- comment -%}
              DIA D 09/09/2026 — gate unico do carrinho. Previa so liga antes
              ou no dia; depois de 09/09 nunca mais aparece.
            {%- endcomment -%}
            {%- assign cart_today = 'now' | date: '%Y%m%d' | plus: 0 -%}
            {%- assign cart_diad_promo = false -%}
            {%- if cart_today == 20260909 -%}
              {%- assign cart_diad_promo = true -%}
            {%- elsif section.settings.preview_diad and cart_today < 20260909 -%}
              {%- assign cart_diad_promo = true -%}
            {%- endif -%}

            {%- render 'vf-frete-progress', diad: cart_diad_promo -%}

            {%- comment -%}
              Aviso de desconto por volume. Recebe o MESMO gate da barra de
              frete acima. Antes o snippet calculava a data sozinho: na previa
              a barra dizia "frete gratis, hoje sem minimo" (Dia D) e logo
              abaixo o aviso mostrava a escada normal, 3=10% / 5=15% / 8=20%.
              Duas verdades diferentes na mesma coluna.
            {%- endcomment -%}
            {%- render 'vf-kits-desconto-aviso', diad: cart_diad_promo -%}

            <div class="vf-cart__summary-row vf-cart__summary-row--total">
              <span>Total</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            {%- comment -%}
              Brindes do dia, sem valor minimo:
              1) 1 Oleo de Alho 500mg, produto fisico, vai na caixa
              2) Manual da Desparasitacao em PDF, por e-mail (NAO e impresso
                 e NAO vai dentro da caixa)
              Os 10% ja estao embutidos no preco dos produtos: o carrinho
              nao aplica nem menciona cupom.
            {%- endcomment -%}
            {%- if cart_diad_promo and cart.item_count > 0 -%}
              <div class="vf-cart-bonus">
                <div class="vf-cart-bonus__head">
                  <span class="vf-cart-bonus__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
                  </span>
                  <div class="vf-cart-bonus__copy">
                    <p class="vf-cart-bonus__title">🎁 Você ganhou: <strong>1 Óleo de Alho 500mg</strong></p>
                    <p class="vf-cart-bonus__sub">Vai junto na sua caixa, sem valor mínimo — não precisa adicionar.</p>
                  </div>
                </div>
                <div class="vf-cart-bonus__pill">SÓ HOJE</div>
              </div>
              <div class="vf-cart-bonus">
                <div class="vf-cart-bonus__head">
                  <span class="vf-cart-bonus__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
                  </span>
                  <div class="vf-cart-bonus__copy">
                    <p class="vf-cart-bonus__title">📩 Você ganhou: <strong>Manual da Desparasitação</strong></p>
                    <p class="vf-cart-bonus__sub">Em PDF, enviado pro seu e-mail depois da compra.</p>
                  </div>
                </div>
                <div class="vf-cart-bonus__pill">SÓ HOJE</div>
              </div>
            {%- endif -%}

            {%- comment -%} Order bump único e mutuamente exclusivo, casado com o conteúdo do carrinho {%- endcomment -%}
            {%- assign cart_has_oleo = false -%}
            {%- assign cart_has_adult = false -%}
            {%- assign cart_protocol_qty = 0 -%}
            {%- assign cart_has_kids24 = false -%}
            {%- assign cart_has_kids59 = false -%}
            {%- for item in cart.items -%}
              {%- if item.product.handle == 'oleo-de-alho-desodorizado-500mg' -%}{%- assign cart_has_oleo = true -%}{%- endif -%}
              {%- if item.product.handle == 'protocolo-desparasitacao-adulto-vermefree' or item.product.handle == 'kit-familia-vermefree-2-adultos-2-criancas' -%}{%- assign cart_has_adult = true -%}{%- endif -%}
              {%- if item.product.handle == 'protocolo-desparasitacao-adulto-vermefree' or item.product.handle == 'antiparasitario-infantil-natural-vermefree-kids-2-a-4-anos' or item.product.handle == 'antiparasitario-infantil-natural-vermefree-kids-5-a-9-anos' -%}{%- assign cart_protocol_qty = cart_protocol_qty | plus: item.quantity -%}{%- endif -%}
              {%- if item.product.handle == 'antiparasitario-infantil-natural-vermefree-kids-2-a-4-anos' -%}{%- assign cart_has_kids24 = true -%}{%- endif -%}
              {%- if item.product.handle == 'antiparasitario-infantil-natural-vermefree-kids-5-a-9-anos' -%}{%- assign cart_has_kids59 = true -%}{%- endif -%}
            {%- endfor -%}
            {%- assign render_bump2 = false -%}
            {%- if cart_has_kids24 and cart_has_kids59 == false -%}{%- assign render_bump2 = true -%}{%- endif -%}
            {%- if cart_has_kids59 and cart_has_kids24 == false -%}{%- assign render_bump2 = true -%}{%- endif -%}
            {%- if cart_protocol_qty > 0 and cart_protocol_qty < 2 -%}{%- assign render_bump2 = true -%}{%- endif -%}
            {%- comment -%} Óleo aparece quando o protocolo já está "completo": adulto/família no carrinho, OU os dois protocolos kids juntos. Aí a próxima oferta natural é a manutenção (Óleo de Alho). {%- endcomment -%}
            {%- assign cart_has_kids_both = false -%}
            {%- if cart_has_kids24 and cart_has_kids59 -%}{%- assign cart_has_kids_both = true -%}{%- endif -%}
            {%- assign show_oleo_bump = false -%}
            {%- if cart_has_oleo == false and cart_has_adult -%}{%- assign show_oleo_bump = true -%}{%- endif -%}
            {%- if cart_has_oleo == false and cart_has_kids_both -%}{%- assign show_oleo_bump = true -%}{%- endif -%}
            {%- comment -%}
              So sobrou o bump do 2o protocolo. O do Oleo de Alho foi desligado
              (08/09) e o snippet dele virou no-op.

              CUIDADO: isto era um if/elsif. Com o carrinho tendo protocolo
              adulto, show_oleo_bump dava true, caia no primeiro ramo e o elsif
              NUNCA era avaliado — entao ao desligar o oleo o carrinho ficou
              sem bump nenhum, levando o do 2o protocolo junto. Sao duas
              ofertas independentes; nao voltem a encadear uma na outra.
            {%- endcomment -%}
            {%- if render_bump2 -%}
              {% render 'vf-order-bump-2protocolo' %}
            {%- endif -%}

            <button type="submit" name="checkout" class="vf-button vf-button--primary vf-button--lg vf-button--full">
              Finalizar compra
            </button>

            <p class="vf-cart__summary-micro">
              Pagamento 100% seguro · Frete pra todo Brasil
            </p>

            <a href="{{ routes.root_url }}" class="vf-cart__continue">
              ← Continuar comprando
            </a>
          </aside>
        </div>
      </form>

      {%- comment -%} Quiz interceptor antes do checkout {%- endcomment -%}
      {%- render 'vf-cart-quiz' -%}
    {%- endif -%}
  </div>
</section>

{%- comment -%} CSS em snippets/vf-cart-css.liquid (tamanho) {%- endcomment -%}
{% render 'vf-cart-css' %}

<script>
  (function () {
    var qtyDecrButtons = document.querySelectorAll('[data-cart-qty-decrease]');
    var qtyIncrButtons = document.querySelectorAll('[data-cart-qty-increase]');
    var qtyInputs = document.querySelectorAll('[data-cart-qty-input]');
    var removeLinks = document.querySelectorAll('[data-cart-remove]');

    function updateLine(key, quantity) {
      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity })
      })
        .then(function (r) { return r.json(); })
        .then(function () { window.location.reload(); })
        .catch(function () { window.location.reload(); });
    }

    qtyDecrButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.dataset.key;
        var input = document.querySelector('[data-cart-qty-input][data-key="' + key + '"]');
        var val = parseInt(input.value, 10) - 1;
        if (val < 0) val = 0;
        updateLine(key, val);
      });
    });
    qtyIncrButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.dataset.key;
        var input = document.querySelector('[data-cart-qty-input][data-key="' + key + '"]');
        var val = parseInt(input.value, 10) + 1;
        updateLine(key, val);
      });
    });
    qtyInputs.forEach(function (input) {
      input.addEventListener('change', function () {
        var val = parseInt(input.value, 10);
        if (isNaN(val) || val < 0) val = 0;
        updateLine(input.dataset.key, val);
      });
    });
    removeLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        updateLine(link.dataset.key, 0);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Carrinho",
  "tag": "section",
  "class": "section section--main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "preview_diad",
      "label": "🔴 PRÉVIA: forçar visual do Dia D (09/09)",
      "info": "Ative só pra testar/ver como fica antes do dia. No dia 09/09 liga sozinho. Depois de 09/09 este checkbox não tem mais efeito.",
      "default": false
    }
  ],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}

