{%- comment -%}
  vf-diad-brinde — brinde automatico do Dia D (09/09/2026).

  POR QUE ISSO EXISTE
  O BXGY nativo do Shopify NAO coloca o item no carrinho: ele so zera o preco
  de um item que ja esta la. Sem este script, quem nao souber adicionar o Oleo
  de Alho sozinho nao ganha nada — e a copy ja foi disparada dizendo que o
  brinde entra automatico.

  TRAVA DE DATA (dupla, de proposito)
  1) Liquid: o script so e renderizado em 09/09 (acao) e 10/09 (limpeza).
  2) JS: a ADICAO so acontece dentro de 09/09/2026 00:00:00–23:59:59 no
     horario de Brasilia, calculado com UTC-3 explicito — nunca no fuso do
     navegador do visitante.
  Fora da janela o desconto nao existe e um oleo adicionado pelo script seria
  COBRADO (R$ 67 que a pessoa nao escolheu). Por isso, fora da janela o script
  so faz uma coisa: REMOVER o brinde que ele mesmo tenha deixado no carrinho.

  MARCADOR
  A linha do brinde leva a propriedade _brinde: "dia-d". O underline esconde a
  propriedade do cliente. E como distinguimos o oleo que o SCRIPT colocou do
  oleo que o CLIENTE escolheu. Nunca removemos um oleo sem esse marcador.
{%- endcomment -%}

{%- assign brinde_hoje = 'now' | date: '%Y%m%d' | plus: 0 -%}
{%- if brinde_hoje == 20260909 or brinde_hoje == 20260910 -%}
<script>
(function () {
  'use strict';

  if (window.__vfDiadBrinde) return;
  window.__vfDiadBrinde = true;
  if (window.Shopify && window.Shopify.designMode) return;
  if (window.location.pathname.indexOf('/checkout') === 0) return;

  var VARIANTE_BRINDE = 48968692891867;
  var PRODUTO_BRINDE  = 9400206262491;
  var PROTOCOLOS = [9345664614619, 9345665827035, 9345667399899, 9345668251867];
  var PROP = '_brinde';
  var VALOR = 'dia-d';

  var URL_CART   = '{{ routes.cart_url }}';
  var URL_ADD    = '{{ routes.cart_add_url }}.js';
  var URL_CHANGE = '{{ routes.cart_change_url }}.js';

  var ocupado = false;
  var refazer = false;
  var passadas = 0;

  /* TRAVA ENTRE ABAS (09/09 ~14h)
     Os pedidos #3112 e #3113 sairam com DOIS frascos numa linha so, os dois
     carregando a propriedade _brinde — ou seja, foi este script que adicionou
     duas vezes, nao o cliente. O motivo: adicionar() pergunta "ja tem oleo?"
     e so depois adiciona; entre a pergunta e a resposta ha uma ida ao
     servidor. Duas abas abertas (ou uma passada disparada enquanto a outra
     estava no ar) ouvem as duas "nao tem" e as duas adicionam. A Shopify
     junta variante+propriedades iguais numa linha so e soma a quantidade.
     A marca no localStorage e compartilhada entre abas do mesmo dominio,
     entao serializa a adicao. TTL curto pra nunca travar pra sempre se a
     aba morrer no meio. */
  var TRAVA_KEY = 'vf_brinde_add_lock';
  var TRAVA_TTL = 8000;

  function pegarTrava() {
    try {
      var agora = Date.now();
      var marca = parseInt(localStorage.getItem(TRAVA_KEY) || '0', 10);
      if (marca && (agora - marca) < TRAVA_TTL) return false;
      localStorage.setItem(TRAVA_KEY, String(agora));
      return true;
    } catch (e) { return true; }
  }

  function soltarTrava() {
    try { localStorage.removeItem(TRAVA_KEY); } catch (e) {}
  }

  /* Janela do Dia D em horario de Brasilia (UTC-3), independente do fuso do
     visitante: desloco o epoch para o relogio de parede de Brasilia e leio
     os getters locais. */
  function naJanela() {
    var agora = new Date();
    var brt = new Date(agora.getTime() + agora.getTimezoneOffset() * 60000 - 10800000);
    return brt.getFullYear() === 2026 && brt.getMonth() === 8 && brt.getDate() === 9;
  }

  function ehOleo(item)      { return item.product_id === PRODUTO_BRINDE; }
  function ehProtocolo(item) { return PROTOCOLOS.indexOf(item.product_id) !== -1; }
  function ehBrinde(item)    {
    return ehOleo(item) && item.properties && item.properties[PROP] === VALOR;
  }

  function pedir(url, opcoes) {
    opcoes = opcoes || {};
    opcoes.credentials = 'same-origin';
    opcoes.headers = opcoes.headers || {};
    opcoes.headers['Accept'] = 'application/json';
    opcoes.headers['X-VF-Brinde'] = '1';
    return fetch(url, opcoes).then(function (r) {
      return r.ok ? r.json() : null;
    });
  }

  function lerCarrinho() { return pedir(URL_CART + '.js'); }

  function adicionar() {
    if (!pegarTrava()) return Promise.resolve(false);
    var corpo = { items: [{ id: VARIANTE_BRINDE, quantity: 1, properties: {} }] };
    corpo.items[0].properties[PROP] = VALOR;
    return pedir(URL_ADD, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(corpo)
    }).then(confirmar(function (cart) {
      return cart.items.some(ehBrinde);
    })).then(function (ok) {
      soltarTrava();
      return ok;
    }, function () {
      soltarTrava();
      return false;
    });
  }

  function remover(linha) {
    return pedir(URL_CHANGE, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: linha.key, quantity: 0 })
    }).then(confirmar(function (cart) {
      return !cart.items.some(ehBrinde);
    }));
  }

  /* Muda a quantidade de UMA linha e so confirma se o total de oleo no
     carrinho realmente caiu. Confirmar a queda (e nao so o "deu 200 ok")
     e o que garante que cada passada reduz de verdade — sem isso a
     condicao continuaria verdadeira e o avaliar() rodaria pra sempre. */
  function ajustar(linha, qtd, totalAntes) {
    return mudarLinha(linha.key, qtd).then(confirmar(function (cart) {
      return totalDeOleo(cart.items) < totalAntes;
    }));
  }

  function mudarLinha(key, qtd) {
    return pedir(URL_CHANGE, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qtd })
    });
  }

  function totalDeOleo(items) {
    return items.filter(ehOleo).reduce(function (n, i) { return n + i.quantity; }, 0);
  }

  /* Só considero que mudou algo depois de reler o carrinho e confirmar.
     Isso e o que impede laco: se o add falhou (esgotado, 422), a condicao
     continua verdadeira mas nao ha reload, entao nao rodamos de novo. */
  function confirmar(teste) {
    return function (resposta) {
      if (!resposta) return false;
      return lerCarrinho().then(function (cart) {
        return !!(cart && cart.items && teste(cart));
      });
    };
  }

  function avaliar() {
    if (ocupado) { refazer = true; return; }
    ocupado = true;

    lerCarrinho().then(function (cart) {
      if (!cart || !cart.items) return false;

      var temProtocolo = cart.items.some(ehProtocolo);
      var oleos   = cart.items.filter(ehOleo);
      var brindes = cart.items.filter(ehBrinde);

      if (!naJanela()) {
        return brindes.length ? remover(brindes[0]) : false;
      }
      /* Cliente que ja tinha oleo por conta propria: nao adiciono outro.
         O BXGY zera o que ja esta la — que e exatamente "1 oleo de brinde". */
      if (temProtocolo && oleos.length === 0) return adicionar();
      if (!temProtocolo && brindes.length)    return remover(brindes[0]);

      /* TRAVA DE 1 FRASCO (09/09 ~01h30)
         O brinde e um desconto simples de 100% na linha do oleo, e desconto
         simples NAO tem trava de quantidade: com 7 frascos no carrinho, os 7
         saiam de graca (R$ 469,00 a zero, visto em teste).
         Quem tem trava de quantidade e o BXGY (discountOnQuantity) — mas BXGY
         consome a linha do protocolo como compra qualificadora e derruba os
         12/15/18% do dia. Da pra ter a trava OU as faixas, nao os dois.
         Entao a trava vive aqui: dentro do Dia D o carrinho nunca fica com
         mais de UM oleo. Hoje o oleo e gratis, entao o cliente nao perde
         nada com isso — so nao consegue estocar de graca.
         Reduz de uma linha por passada; o reload/refazer cuida do resto. */
      var totalOleo = totalDeOleo(cart.items);
      if (totalOleo > 1) {
        var manter = brindes.length ? brindes[0] : oleos[0];
        for (var i = 0; i < oleos.length; i++) {
          if (oleos[i].key !== manter.key) return ajustar(oleos[i], 0, totalOleo);
        }
        return ajustar(manter, 1, totalOleo);
      }
      return false;
    })
    .catch(function () { return false; })
    .then(function (mudou) {
      ocupado = false;
      if (mudou) {
        if (naPaginaDoCarrinho()) { window.location.reload(); return; }
        /* Fora do carrinho nao ha reload, e ate agora a correcao so voltava
           a rodar na PROXIMA pagina. Era essa a brecha: adicionar um oleo
           numa PDP e ir direto pro checkout com dois. Agora a propria
           passada continua ate o carrinho estar certo.
           Termina sempre: adicionar() so roda com zero oleo no carrinho, e
           ajustar() so reduz. O teto de passadas e cinto de seguranca. */
        if (passadas < 5) { passadas += 1; avaliar(); return; }
      }
      if (refazer) { refazer = false; avaliar(); return; }
      marcarBrinde();
      blindarCheckout();
    });
  }

  /* PONTO 3: segurar o "Finalizar compra".
     Mesmo com tudo acima, quem clicasse em finalizar no mesmo segundo da
     adicao escapava. Agora o clique para, o carrinho e conferido e cortado,
     e so entao segue pro checkout.
     NUNCA bloqueia a venda: se a conferencia falhar ou passar de 3s, o
     cliente vai pro checkout do mesmo jeito. Um frasco a mais custa R$ 67;
     uma compra travada custa a compra inteira. */
  function comTimeout(promessa, ms) {
    return new Promise(function (resolve) {
      var feito = false;
      function fim() { if (!feito) { feito = true; resolve(); } }
      setTimeout(fim, ms);
      promessa.then(fim, fim);
    });
  }

  function normalizarAgora() {
    return lerCarrinho().then(function (cart) {
      if (!cart || !cart.items) return null;
      if (totalDeOleo(cart.items) <= 1) return null;
      var oleos   = cart.items.filter(ehOleo);
      var brindes = cart.items.filter(ehBrinde);
      var manter  = brindes.length ? brindes[0] : oleos[0];
      var fila = Promise.resolve();
      oleos.forEach(function (o) {
        if (o.key === manter.key) return;
        fila = fila.then(function () { return mudarLinha(o.key, 0); });
      });
      return fila.then(function () { return mudarLinha(manter.key, 1); });
    });
  }

  function blindarCheckout() {
    if (!naPaginaDoCarrinho()) return;
    var form = document.querySelector('[data-vf-cart-form]');
    if (!form || form.getAttribute('data-vf-blindado')) return;
    form.setAttribute('data-vf-blindado', '1');
    form.addEventListener('submit', function (ev) {
      if (!naJanela()) return;
      ev.preventDefault();
      comTimeout(normalizarAgora().catch(function () {}), 3000).then(function () {
        /* Reenvio o proprio form com o campo "checkout" em vez de mandar
           pra /checkout na mao: e assim que a Shopify decide o destino, e
           form.submit() nao dispara este listener de novo (sem laco). */
        var flag = document.createElement('input');
        flag.type = 'hidden';
        flag.name = 'checkout';
        flag.value = '';
        form.appendChild(flag);
        form.submit();
      });
    });
  }

  function naPaginaDoCarrinho() {
    return window.location.pathname.split('?')[0].replace(/\/$/, '') === URL_CART;
  }

  /* O carrinho do tema renderiza cada linha como [data-cart-item][data-key].
     Uso a key vinda do /cart.js pra achar a linha certa e rotular. Se o tema
     mudar a marcacao, nada quebra: so nao rotula. */
  function marcarBrinde() {
    if (!naPaginaDoCarrinho()) return;
    lerCarrinho().then(function (cart) {
      if (!cart || !cart.items) return;
      cart.items.forEach(function (item) {
        if (!ehBrinde(item)) return;
        var linha = document.querySelector('[data-key="' + item.key + '"]');
        while (linha && !linha.hasAttribute('data-cart-item')) linha = linha.parentElement;
        if (!linha || linha.querySelector('.vf-brinde-tag')) return;

        linha.classList.add('vf-brinde-linha');
        var alvo = linha.querySelector('.vf-cart-item__title') || linha;
        var tag = document.createElement('span');
        tag.className = 'vf-brinde-tag';
        tag.textContent = '🎁 Brinde do Dia D · Grátis';
        alvo.parentNode.insertBefore(tag, alvo.nextSibling);

        /* Sem isto, o segundo frasco some da tela sem explicacao e parece
           bug do site. */
        var nota = document.createElement('span');
        nota.className = 'vf-brinde-nota';
        nota.textContent = 'O brinde do Dia D e 1 frasco por pedido.';
        tag.parentNode.insertBefore(nota, tag.nextSibling);

        /* Brinde nao tem quantidade escolhivel. Enquanto o "+" existia nesta
           linha, dava pra subir pra 2 e ver o carrinho errado PISCAR antes da
           correcao chegar — parecia que a trava nao funcionava.
           Escondo os botoes por CSS (classe vf-brinde-linha, ja aplicada
           acima) e travo o campo. NAO removo o input: o form do carrinho
           manda updates[] por POSICAO, entao tirar um input desalinharia as
           quantidades de todas as outras linhas. */
        var qtd = linha.querySelector('.vf-cart-item__qty-input');
        if (qtd) {
          qtd.readOnly = true;
          qtd.setAttribute('tabindex', '-1');
          qtd.setAttribute('aria-label', 'Brinde: 1 frasco, quantidade fixa');
        }

        /* O "de R$ 67,00" riscado saiu daqui em 09/09 ~01h: agora quem
           desenha isso e o proprio main-cart, em Liquid, pra TODA linha
           com desconto. Deixar os dois desenhando duplicava o riscado. */
      });
    }).catch(function () {});
  }

  function dinheiro(centavos) {
    return 'R$ ' + (centavos / 100).toFixed(2).replace('.', ',');
  }

  /* O tema recarrega a pagina depois de mexer no carrinho, entao o load ja
     cobre quase tudo. O wrapper abaixo pega os casos que nao recarregam
     (drawer, quantidade inline) sem depender de evento proprio do tema. */
  try {
    var fetchOriginal = window.fetch;
    window.fetch = function (entrada, init) {
      var url = (typeof entrada === 'string') ? entrada : (entrada && entrada.url) || '';
      var nosso = !!(init && init.headers && init.headers['X-VF-Brinde']);
      var mexeuNoCarrinho = /\/cart\/(add|change|update|clear)/.test(url);
      return fetchOriginal.apply(this, arguments).then(function (r) {
        if (mexeuNoCarrinho && !nosso && r.ok) setTimeout(avaliar, 0);
        return r;
      });
    };
  } catch (e) { /* silencio: o brinde nao pode quebrar a loja */ }

  ['cart:updated', 'cart:refresh', 'cart:update'].forEach(function (evt) {
    document.addEventListener(evt, function () { setTimeout(avaliar, 0); });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { blindarCheckout(); avaliar(); });
  } else {
    blindarCheckout();
    avaliar();
  }
})();
</script>
{%- endif -%}

{% stylesheet %}
  .vf-brinde-tag {
    display: inline-block;
    margin: 4px 0 0;
    padding: 3px 10px;
    border-radius: 999px;
    background: #E11D2E;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.5;
    white-space: nowrap;
  }
  .vf-brinde-nota {
    display: block;
    margin: 3px 0 0;
    font-size: 11.5px;
    color: #6B6B6B;
    line-height: 1.4;
  }
  .vf-brinde-de {
    color: #9A9A9A;
    font-weight: 400;
    margin-right: 6px;
  }
  .vf-brinde-linha .vf-cart-item__price,
  .vf-brinde-linha .vf-cart-item__price-mobile {
    color: #1B5E20;
    font-weight: 800;
  }
  {%- comment -%} Linha do brinde: sem +/-, quantidade fixa em 1 {%- endcomment -%}
  .vf-brinde-linha .vf-cart-item__qty-btn { display: none; }
  .vf-brinde-linha .vf-cart-item__qty-control {
    border-color: transparent;
    background: #F2F2F2;
  }
  .vf-brinde-linha .vf-cart-item__qty-input {
    pointer-events: none;
    color: #6B6B6B;
  }
{% endstylesheet %}
