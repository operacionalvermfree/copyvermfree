{%- comment -%}
  vf-diagnostico-popup.liquid — POP-UP DE CAPTURA DE E-MAIL (1 PASSO)

  SIMPLIFICADO EM 08/09 (pedido do Gabriel). Antes era um recomendador de
  3 etapas (publico -> dor -> resultado + captura). Virou um passo unico:
  captura o e-mail e entrega o cupom 5OFF. O quiz inteiro saiu — quem
  quiser resgatar o fluxo antigo, ele esta em
  shopify/dia-d-09-09/backup-original/vf-diagnostico-popup.liquid.

  MOTIVO: 3 etapas antes de pedir o e-mail derruba muita gente. O objetivo
  desta peca e uma coisa so — entrar o e-mail na base com o cupom padrao
  da loja.

  GATILHO: entrada ~4s, 1x a cada 5 dias (cookie). Nao aparece em
  cart/checkout/account e nao empilha com o pop-up de oleo.

  CAPTURA: {% form 'customer' %} (contact[email] + contact[tags]) via AJAX,
  sem recarregar a pagina.

  TAG: mantida como "quiz-diagnostico" DE PROPOSITO, junto com a nova
  "popup-5off". A tag antiga pode estar amarrada em automacao/segmento no
  ActiveCampaign — renomear sozinho quebraria o fluxo de quem ja esta la.

  ONDE ELE NAO APARECE: o render fica em layout/theme.liquid dentro de um
  {% unless %} que corta o pop-up no dia 09/09. No Dia D a oferta e
  12/15/18% aplicada no carrinho e um codigo de 5% na tela competiria com
  ela. Volta a aparecer sozinho no dia 10.

  LINGUAGEM (ANVISA): so bem-estar, rotina e leveza. Nada de cura,
  eliminacao de parasitas, prazo de resultado ou diagnostico do leitor.
{%- endcomment -%}

<div class="vf-diag" id="vf-diag" hidden aria-hidden="true">
  <div class="vf-diag__overlay" data-diag-close></div>
  <div class="vf-diag__card" role="dialog" aria-modal="true" aria-labelledby="vf-diag-title">
    <button type="button" class="vf-diag__x" data-diag-close aria-label="Fechar">&times;</button>

    <span class="vf-diag__badge">🌙 cupom de boas-vindas</span>

    <h2 class="vf-diag__title" id="vf-diag-title">
      Leve <span class="vf-diag__hl">5% OFF</span> pra começar sua rotina de desparasitação natural
    </h2>
    <p class="vf-diag__sub">
      Deixa seu e-mail que eu te mando o cupom <strong>5OFF</strong> — dá pra usar quando você decidir começar o protocolo, sem pressa.
    </p>

    {%- form 'customer', id: 'vf-diag-form', class: 'vf-diag__form' -%}
      <input type="hidden" name="contact[tags]" value="quiz-diagnostico,popup-5off">
      <label class="vf-diag__form-label" for="vf-diag-email">Seu melhor e-mail</label>
      <input type="email" id="vf-diag-email" name="contact[email]" placeholder="voce@email.com.br" required autocomplete="email">
      <button type="submit" class="vf-diag__form-btn">Quero meu cupom 5OFF</button>
      <p class="vf-diag__form-mini">Sem spam. Cuidado natural, no seu tempo. 🌿</p>
    {%- endform -%}

    <div class="vf-diag__success" hidden>
      <p class="vf-diag__success-msg">
        🎉 Prontinho! Seu cupom é <span class="vf-diag__code">5OFF</span>
      </p>
      <a href="/discount/5OFF?redirect=/" class="vf-diag__cta">Aplicar e ver os protocolos →</a>
    </div>

    <button type="button" class="vf-diag__skip" data-diag-close>Agora não, obrigada</button>
  </div>
</div>

{% stylesheet %}
  .vf-diag { position: fixed; inset: 0; z-index: 9998; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .vf-diag[hidden] { display: none; }
  .vf-diag__overlay { position: absolute; inset: 0; background: rgba(20, 32, 20, 0.55); backdrop-filter: blur(2px); animation: vf-diag-fade .25s ease; }
  .vf-diag__card {
    position: relative; width: 100%; max-width: 420px; max-height: 92vh; overflow-y: auto;
    background: #FDFDF9; border-radius: 20px; padding: 30px 24px 20px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.28);
    animation: vf-diag-pop .3s cubic-bezier(.2,.8,.3,1);
    text-align: center;
  }
  .vf-diag__card::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 5px;
    background: linear-gradient(90deg, #1B5E20 0%, #5EBC43 60%, #A8DC7A 100%);
    border-radius: 20px 20px 0 0;
  }
  @keyframes vf-diag-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes vf-diag-pop { from { opacity: 0; transform: translateY(16px) scale(.97); } to { opacity: 1; transform: none; } }

  .vf-diag__x { position: absolute; top: 12px; right: 12px; border: 0; background: transparent; font-size: 26px; line-height: 1; color: #9AA69A; cursor: pointer; padding: 4px 8px; }
  .vf-diag__x:hover { color: #444; }

  .vf-diag__badge {
    display: inline-block; background: #EAF7E4; color: #1B5E20;
    font-size: 11.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
    padding: 5px 12px; border-radius: 999px; margin: 0 0 14px;
  }
  .vf-diag__title { margin: 0 0 10px; font-size: 23px; line-height: 1.22; font-weight: 800; color: #16301A; }
  .vf-diag__hl { color: #1B5E20; background: linear-gradient(180deg, transparent 62%, #C7E7B8 62%); padding: 0 3px; }
  .vf-diag__sub { margin: 0 0 20px; font-size: 14px; line-height: 1.5; color: #5B6B5B; }
  .vf-diag__sub strong { color: #1B5E20; font-weight: 800; }

  .vf-diag__form { margin: 0 0 6px; text-align: left; }
  .vf-diag__form-label { display: block; font-size: 12.5px; font-weight: 700; color: #3D4A3D; margin: 0 0 6px; }
  .vf-diag__form input[type="email"] {
    display: block; width: 100%; box-sizing: border-box; padding: 13px 14px;
    border: 1.5px solid #D8DED0; border-radius: 12px; font-size: 15px; background: #fff;
  }
  .vf-diag__form input[type="email"]:focus { outline: none; border-color: #5EBC43; box-shadow: 0 0 0 3px rgba(94,188,67,.16); }
  .vf-diag__form-btn {
    display: block; width: 100%; margin-top: 10px; border: 0; border-radius: 12px;
    background: #5EBC43; color: #fff; font-weight: 800; font-size: 15.5px; padding: 14px;
    cursor: pointer; box-shadow: 0 4px 0 #1B5E20; transition: transform .12s ease;
  }
  .vf-diag__form-btn:hover { transform: translateY(-1px); }
  .vf-diag__form-btn:active { transform: translateY(2px); box-shadow: 0 2px 0 #1B5E20; }
  .vf-diag__form-btn[disabled] { opacity: .7; cursor: default; transform: none; }
  .vf-diag__form-mini { margin: 10px 0 0; font-size: 11.5px; color: #9AA69A; text-align: center; }

  .vf-diag__success { margin: 4px 0 8px; }
  .vf-diag__success-msg { margin: 0 0 12px; background: #EAF7E4; border: 1px solid #C7E7B8; border-radius: 12px; padding: 13px 14px; font-size: 14px; font-weight: 600; color: #1B5E20; }
  .vf-diag__code { display: inline-block; background: #1B5E20; color: #fff; font-weight: 800; letter-spacing: .06em; padding: 3px 9px; border-radius: 6px; margin: 0 2px; }
  .vf-diag__cta {
    display: block; text-align: center; text-decoration: none; background: #1B5E20; color: #fff;
    font-weight: 800; font-size: 15px; padding: 13px; border-radius: 12px; transition: background .18s ease;
  }
  .vf-diag__cta:hover { background: #164a1a; color: #fff; }

  .vf-diag__skip { display: block; width: 100%; border: 0; background: transparent; color: #9AA69A; font-size: 12.5px; margin-top: 12px; cursor: pointer; }
  .vf-diag__skip:hover { color: #5B6B5B; }

  @media (max-width: 480px) {
    .vf-diag__card { padding: 26px 18px 16px; border-radius: 18px; }
    .vf-diag__title { font-size: 20px; }
  }
{% endstylesheet %}

<script>
(function () {
  var root = document.getElementById('vf-diag');
  if (!root) return;

  var COOKIE = 'vf_diag_popup';
  var DELAY_MS = 4000;
  var SNOOZE_DAYS = 5;
  var CONVERTED_DAYS = 30;

  function getCookie(name) {
    var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
    return m ? decodeURIComponent(m[1]) : null;
  }
  function setCookie(name, val, days) {
    var d = new Date(); d.setTime(d.getTime() + days * 864e5);
    document.cookie = name + '=' + encodeURIComponent(val) + '; expires=' + d.toUTCString() + '; path=/; SameSite=Lax';
  }

  // Nao mostrar em cart/checkout/account, nem se o pop-up de oleo apareceu nesta sessao
  var path = window.location.pathname;
  if (/^\/(cart|checkout|account)/.test(path)) return;
  try { if (sessionStorage.getItem('vf_oleopop_shown')) return; } catch (e) {}
  if (getCookie(COOKIE)) return;

  var form = document.getElementById('vf-diag-form');
  var successBox = root.querySelector('.vf-diag__success');

  function openPopup() {
    root.hidden = false;
    root.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setCookie(COOKIE, '1', SNOOZE_DAYS);
  }
  function closePopup() {
    root.hidden = true;
    root.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  root.addEventListener('click', function (e) {
    var closeEl = e.target.closest('[data-diag-close]');
    if (closeEl) { e.preventDefault(); closePopup(); }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !root.hidden) closePopup();
  });

  // Captura de e-mail (AJAX, sem recarregar)
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var emailField = form.querySelector('[name="contact[email]"]');
      var email = emailField ? emailField.value : '';
      if (!email) return;
      var btn = form.querySelector('.vf-diag__form-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
      var data = new FormData(form);
      fetch(form.action || '/contact', { method: 'POST', body: data, headers: { 'Accept': 'text/html' } })
        .catch(function () {})
        .finally(function () {
          setCookie(COOKIE, 'converted', CONVERTED_DAYS);
          form.hidden = true;
          if (successBox) successBox.hidden = false;
        });
    });
  }

  // Gatilho: entrada ~4s
  window.setTimeout(function () {
    if (getCookie(COOKIE)) return;
    openPopup();
  }, DELAY_MS);
})();
</script>
