{%- comment -%}
  vf-order-bump-2protocolo.liquid — ORDER BUMP 2o Protocolo

  Cartao no carrinho pra levar um segundo protocolo (Adulto, Kids 2-4
  ou Kids 5-9 — nunca Kit Familia).

  NENHUM PRECO AQUI E ESCRITO A MAO. Antes eram texto fixo ("de
  R$ 347,00 / R$ 294,95") com um aviso pedindo revisao manual antes do
  Dia D — o jeito classico de o cliente ver um valor e pagar outro.
  Agora o preco cheio vem de all_products[handle].price e o percentual
  de b2_pct.

  O PERCENTUAL. Fora do Dia D: 15%, do desconto automatico "Order Bump
  · 2o Protocolo 15% OFF" (BXGY, limite 1). No Dia D (09/09/2026) a
  acao e 12% / 15% (3 un) / 18% (5 un); descontos de produto nao somam
  na mesma linha, o Shopify aplica o melhor dos dois. Logo: ate 4
  unidades os 15% do bump ganham ou empatam, de 5 em diante ganham os
  18% do dia. Por isso b2_pct so sobe pra 18 quando cart.item_count + 1
  chega a 5 — nunca anuncia mais desconto do que o checkout aplica.
{%- endcomment -%}

{%- assign ADULTO_HANDLE = 'protocolo-desparasitacao-adulto-vermefree' -%}
{%- assign KIDS24_HANDLE = 'antiparasitario-infantil-natural-vermefree-kids-2-a-4-anos' -%}
{%- assign KIDS59_HANDLE = 'antiparasitario-infantil-natural-vermefree-kids-5-a-9-anos' -%}
{%- assign ADULTO_VARIANT_ID = 48772143415515 -%}
{%- assign KIDS24_VARIANT_ID = 48772145250523 -%}
{%- assign KIDS59_VARIANT_ID = 48772147085531 -%}

{%- assign b2_today = 'now' | date: '%Y%m%d' | plus: 0 -%}
{%- assign b2_diad = false -%}
{%- if b2_today == 20260909 -%}{%- assign b2_diad = true -%}{%- endif -%}

{%- assign b2_pct = 15 -%}
{%- if b2_diad -%}
  {%- assign b2_apos = cart.item_count | plus: 1 -%}
  {%- if b2_apos >= 5 -%}{%- assign b2_pct = 18 -%}{%- endif -%}
{%- endif -%}
{%- assign b2_paga = 100 | minus: b2_pct -%}

{%- comment -%} precos cheios do catalogo; os numeros abaixo so valem se o produto sumir {%- endcomment -%}
{%- assign adulto_product = all_products[ADULTO_HANDLE] -%}
{%- assign kids24_product = all_products[KIDS24_HANDLE] -%}
{%- assign kids59_product = all_products[KIDS59_HANDLE] -%}

{%- assign adulto_full = 34700 -%}
{%- if adulto_product != blank and adulto_product.price > 0 -%}{%- assign adulto_full = adulto_product.price -%}{%- endif -%}
{%- assign kids24_full = 27000 -%}
{%- if kids24_product != blank and kids24_product.price > 0 -%}{%- assign kids24_full = kids24_product.price -%}{%- endif -%}
{%- assign kids59_full = 38900 -%}
{%- if kids59_product != blank and kids59_product.price > 0 -%}{%- assign kids59_full = kids59_product.price -%}{%- endif -%}

{%- assign adulto_pay = adulto_full | times: b2_paga | divided_by: 100 -%}
{%- assign kids24_pay = kids24_full | times: b2_paga | divided_by: 100 -%}
{%- assign kids59_pay = kids59_full | times: b2_paga | divided_by: 100 -%}

{%- assign cart_has_adulto = false -%}
{%- assign protocol_qty = 0 -%}
{%- for item in cart.items -%}
  {%- if item.product.handle == ADULTO_HANDLE -%}
    {%- assign cart_has_adulto = true -%}
    {%- assign protocol_qty = protocol_qty | plus: item.quantity -%}
  {%- elsif item.product.handle == KIDS24_HANDLE or item.product.handle == KIDS59_HANDLE -%}
    {%- assign protocol_qty = protocol_qty | plus: item.quantity -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Dinamica Kids-irmaos: se tem uma faixa Kids no carrinho, oferece SO a outra faixa {%- endcomment -%}
{%- assign cart_has_kids24 = false -%}
{%- assign cart_has_kids59 = false -%}
{%- for item in cart.items -%}
  {%- if item.product.handle == KIDS24_HANDLE -%}{%- assign cart_has_kids24 = true -%}{%- endif -%}
  {%- if item.product.handle == KIDS59_HANDLE -%}{%- assign cart_has_kids59 = true -%}{%- endif -%}
{%- endfor -%}
{%- assign bump2_kids_sibling = false -%}
{%- if cart_has_kids24 and cart_has_kids59 == false -%}
  {%- assign bump2_kids_sibling = true -%}
  {%- assign sib_variant = KIDS59_VARIANT_ID -%}
  {%- assign sib_label = 'Kids 5 a 9 anos' -%}
  {%- assign sib_price = kids59_pay -%}
  {%- assign sib_full = kids59_full -%}
{%- elsif cart_has_kids59 and cart_has_kids24 == false -%}
  {%- assign bump2_kids_sibling = true -%}
  {%- assign sib_variant = KIDS24_VARIANT_ID -%}
  {%- assign sib_label = 'Kids 2 a 4 anos' -%}
  {%- assign sib_price = kids24_pay -%}
  {%- assign sib_full = kids24_full -%}
{%- endif -%}

{%- assign show_bump2 = false -%}
{%- if bump2_kids_sibling -%}{%- assign show_bump2 = true -%}{%- endif -%}
{%- if protocol_qty > 0 and protocol_qty < 2 -%}{%- assign show_bump2 = true -%}{%- endif -%}
{%- if show_bump2 -%}
  <div class="vf-bump2{% if bump2_kids_sibling %} vf-bump2--red{% endif %}" data-vf-bump2>
    <div class="vf-bump2__head">
      {%- if bump2_kids_sibling -%}
        <span class="vf-bump2__title">Tem criança de outra idade? Leve com {{ b2_pct }}% OFF 🌿</span>
        {%- unless cart_has_adulto -%}
        <span class="vf-bump2__desc">Cada idade tem a sua dose. Adicione o <strong>{{ sib_label }}</strong> pra criança — ou aproveite e leve também o <strong>protocolo adulto</strong> pra você — e cuide de todos na mesma lua nova, com {{ b2_pct }}% OFF.</span>
        {%- else -%}
        <span class="vf-bump2__desc">Cada idade tem a sua dose. Adicione o <strong>{{ sib_label }}</strong> e cuide de todos na mesma lua nova — a desparasitação natural funciona na constância.</span>
        {%- endunless -%}
      {%- else -%}
        <span class="vf-bump2__title">Leve um 2º protocolo com {{ b2_pct }}% OFF 🌿</span>
        <span class="vf-bump2__desc">Garanta o protocolo de outra pessoa da família — ou já adiante seu próximo ciclo. A desparasitação natural funciona na constância, e assim você não perde o ritmo.</span>
      {%- endif -%}
      {%- if b2_diad -%}
      <span class="vf-bump2__diad">🚨 Só hoje: o desconto entra sozinho no carrinho, sem cupom — e o frasco de brinde continua indo no seu pedido.</span>
      {%- endif -%}
    </div>

    <div class="vf-bump2__options" role="radiogroup" aria-label="Escolha o 2º protocolo">
      {%- if bump2_kids_sibling -%}
      <label class="vf-bump2__opt">
        <input type="radio" name="vf-bump2-choice" value="sibling" data-vf-bump2-opt data-variant-id="{{ sib_variant }}" data-label="{{ sib_label }}" data-price="{{ sib_price }}" checked>
        <span class="vf-bump2__opt-inner">
          <span class="vf-bump2__opt-radio" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
          </span>
          <span class="vf-bump2__opt-main">
            <span class="vf-bump2__opt-dur">{{ sib_label }}</span>
            <span class="vf-bump2__opt-sub">desparasitação natural infantil</span>
          </span>
          <span class="vf-bump2__opt-priceblock">
            <span class="vf-bump2__opt-full">de {{ sib_full | money }}</span>
            <span class="vf-bump2__opt-price">{{ sib_price | money }}</span>
          </span>
        </span>
      </label>
      {%- unless cart_has_adulto -%}
      <label class="vf-bump2__opt">
        <input type="radio" name="vf-bump2-choice" value="adulto" data-vf-bump2-opt data-variant-id="{{ ADULTO_VARIANT_ID }}" data-label="Protocolo Adulto" data-price="{{ adulto_pay }}">
        <span class="vf-bump2__opt-inner">
          <span class="vf-bump2__opt-radio" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
          </span>
          <span class="vf-bump2__opt-main">
            <span class="vf-bump2__opt-dur">Protocolo Adulto</span>
            <span class="vf-bump2__opt-sub">pra você ou outro adulto da família</span>
          </span>
          <span class="vf-bump2__opt-priceblock">
            <span class="vf-bump2__opt-full">de {{ adulto_full | money }}</span>
            <span class="vf-bump2__opt-price">{{ adulto_pay | money }}</span>
          </span>
        </span>
      </label>
      {%- endunless -%}
      {%- else -%}
      <label class="vf-bump2__opt">
        <input type="radio" name="vf-bump2-choice" value="adulto" data-vf-bump2-opt data-variant-id="{{ ADULTO_VARIANT_ID }}" data-label="Protocolo Adulto" data-price="{{ adulto_pay }}" checked>
        <span class="vf-bump2__opt-inner">
          <span class="vf-bump2__opt-radio" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
          </span>
          <span class="vf-bump2__opt-main">
            <span class="vf-bump2__opt-dur">Outro Protocolo Adulto</span>
            <span class="vf-bump2__opt-sub">pra outra pessoa da família</span>
          </span>
          <span class="vf-bump2__opt-priceblock">
            <span class="vf-bump2__opt-full">de {{ adulto_full | money }}</span>
            <span class="vf-bump2__opt-price">{{ adulto_pay | money }}</span>
          </span>
        </span>
      </label>

      <label class="vf-bump2__opt">
        <input type="radio" name="vf-bump2-choice" value="kids24" data-vf-bump2-opt data-variant-id="{{ KIDS24_VARIANT_ID }}" data-label="Kids 2-4 anos" data-price="{{ kids24_pay }}">
        <span class="vf-bump2__opt-inner">
          <span class="vf-bump2__opt-radio" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
          </span>
          <span class="vf-bump2__opt-main">
            <span class="vf-bump2__opt-dur">Kids 2 a 4 anos</span>
            <span class="vf-bump2__opt-sub">desparasitação natural infantil</span>
          </span>
          <span class="vf-bump2__opt-priceblock">
            <span class="vf-bump2__opt-full">de {{ kids24_full | money }}</span>
            <span class="vf-bump2__opt-price">{{ kids24_pay | money }}</span>
          </span>
        </span>
      </label>

      <label class="vf-bump2__opt">
        <input type="radio" name="vf-bump2-choice" value="kids59" data-vf-bump2-opt data-variant-id="{{ KIDS59_VARIANT_ID }}" data-label="Kids 5-9 anos" data-price="{{ kids59_pay }}">
        <span class="vf-bump2__opt-inner">
          <span class="vf-bump2__opt-radio" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
          </span>
          <span class="vf-bump2__opt-main">
            <span class="vf-bump2__opt-dur">Kids 5 a 9 anos</span>
            <span class="vf-bump2__opt-sub">desparasitação natural infantil</span>
          </span>
          <span class="vf-bump2__opt-priceblock">
            <span class="vf-bump2__opt-full">de {{ kids59_full | money }}</span>
            <span class="vf-bump2__opt-price">{{ kids59_pay | money }}</span>
          </span>
        </span>
      </label>
      {%- endif -%}
    </div>

    <label class="vf-bump2__checkbox">
      <input type="checkbox" data-vf-bump2-confirm>
      <span class="vf-bump2__checkbox-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
      </span>
      <span>Sim, quero adicionar com {{ b2_pct }}% OFF</span>
    </label>

    <button type="button" class="vf-bump2__cta" data-vf-bump2-cta disabled>
      <span data-vf-bump2-cta-label>Marque a caixa acima pra adicionar</span>
    </button>

    <div class="vf-bump2__spinner" data-vf-bump2-spinner hidden>Adicionando…</div>
  </div>

  <script>
    (function () {
      var wrap = document.querySelector('[data-vf-bump2]');
      if (!wrap) return;
      var opts    = wrap.querySelectorAll('[data-vf-bump2-opt]');
      var confirm = wrap.querySelector('[data-vf-bump2-confirm]');
      var cta     = wrap.querySelector('[data-vf-bump2-cta]');
      var ctaLbl  = wrap.querySelector('[data-vf-bump2-cta-label]');
      var spinner = wrap.querySelector('[data-vf-bump2-spinner]');
      var busy = false;

      function formatBRL(cents) {
        return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');
      }

      function selectedOpt() {
        var checked = wrap.querySelector('[data-vf-bump2-opt]:checked');
        return checked;
      }

      function updateCta() {
        var opt = selectedOpt();
        if (!opt) return;
        if (confirm.checked) {
          cta.disabled = false;
          ctaLbl.textContent = 'Adicionar ' + opt.dataset.label + ' — ' + formatBRL(parseInt(opt.dataset.price, 10));
        } else {
          cta.disabled = true;
          ctaLbl.textContent = 'Marque a caixa acima pra adicionar';
        }
      }

      opts.forEach(function (o) {
        o.addEventListener('change', updateCta);
      });
      confirm.addEventListener('change', updateCta);

      cta.addEventListener('click', function () {
        if (busy || cta.disabled) return;
        var opt = selectedOpt();
        if (!opt) return;
        busy = true;
        wrap.classList.add('is-busy');
        if (spinner) spinner.hidden = false;
        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(opt.dataset.variantId, 10), quantity: 1 }] })
        }).then(function () { window.location.reload(); })
          .catch(function () { window.location.reload(); });
      });

      updateCta();
    })();
  </script>
{%- endif -%}

{%- render 'vf-bump2-css' -%}


