{%- comment -%}
  vf-announcement-bar — Tarja rotativa no topo do site
  Múltiplas mensagens via blocks, fade entre elas
  Configurável via editor visual: cores, intervalo, mensagens
{%- endcomment -%}

{%- assign ann_show = section.settings.show -%}
{%- if section.settings.show == nil -%}{%- assign ann_show = true -%}{%- endif -%}

{%- assign ann_bg = section.settings.bg_color | default: '#1B5E20' -%}
{%- assign ann_text_color = section.settings.text_color | default: '#FFFFFF' -%}
{%- assign ann_interval = section.settings.interval | default: 5 -%}

{%- comment -%}
  PROMO — Frete gratis SEM MINIMO. Sem trava de data: quem controla o quando
  e a PUBLICACAO DESTE TEMA. Enquanto ele estiver no ar, a tarja anuncia a
  promo; quando sair do ar, some junto.
  Pra desligar sem despublicar, e so desmarcar "Modo promo" no editor.

  ⚠️ O desconto de verdade e o automatico "Frete Gratis · Fim de Semana
  05-06/09 (sem minimo)" no Shopify, que e DA LOJA e nao do tema. Esta tarja
  so comunica — se o desconto nao estiver valendo, ela promete o que o
  checkout nao cumpre.

  O contador usa "Fim da promo". Deixe em branco pra anunciar sem contador —
  melhor em branco do que com data vencida, que zera e fica "00:00:00".
{%- endcomment -%}
{%- assign ann_promo_active = section.settings.promo_on -%}
{%- if section.settings.promo_on == nil -%}{%- assign ann_promo_active = true -%}{%- endif -%}
{%- assign ann_promo_end = section.settings.promo_end -%}
{%- if ann_promo_active -%}
  {%- assign ann_bg = '#E11D2E' -%}
  {%- assign ann_text_color = '#FFFFFF' -%}
{%- endif -%}

{%- if ann_show -%}
  <div class="vf-announcement{% if ann_promo_active %} vf-announcement--promo{% endif %}"
       style="--vf-ann-bg: {{ ann_bg }}; --vf-ann-text: {{ ann_text_color }};"
       data-vf-ann
       data-interval="{{ ann_interval }}">
    <div class="vf-announcement__track">
      {%- if ann_promo_active -%}
        <div class="vf-announcement__slide is-active" data-slide>
          <span class="vf-announcement__text vf-announcement__text--promo">
            {%- if ann_promo_end != blank -%}
              🚨 FRETE GRÁTIS SEM MÍNIMO — acaba em
              <strong class="vf-ann-countdown" data-countdown="{{ ann_promo_end }}">--:--:--</strong>
            {%- else -%}
              🚨 FRETE GRÁTIS SEM MÍNIMO em todo o site
            {%- endif -%}
          </span>
        </div>
      {%- else -%}
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'message' -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"
                   class="vf-announcement__slide {% if forloop.first %}is-active{% endif %}"
                   data-slide
                   {{ block.shopify_attributes }}>
                  <span class="vf-announcement__text">{{ block.settings.text }}</span>
                </a>
              {%- else -%}
                <div class="vf-announcement__slide {% if forloop.first %}is-active{% endif %}"
                     data-slide
                     {{ block.shopify_attributes }}>
                  <span class="vf-announcement__text">{{ block.settings.text }}</span>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback se não tiver blocks configurados {%- endcomment -%}
          <div class="vf-announcement__slide is-active" data-slide>
            <span class="vf-announcement__text">🚚 FRETE GRÁTIS em pedidos acima de R$ 399</span>
          </div>
          <div class="vf-announcement__slide" data-slide>
            <span class="vf-announcement__text">🎟️ Use o cupom <strong>5OFF</strong> e ganhe 5% de desconto</span>
          </div>
          <div class="vf-announcement__slide" data-slide>
            <span class="vf-announcement__text">💳 PARCELAMENTO em até 10x</span>
          </div>
          <div class="vf-announcement__slide" data-slide>
            <span class="vf-announcement__text">🌿 PROTOCOLO 100% FITOTERÁPICO</span>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .vf-announcement {
    background: var(--vf-ann-bg, #1B5E20);
    color: var(--vf-ann-text, #FFFFFF);
    padding: 10px 20px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.3px;
    position: relative;
    z-index: 50;
    overflow: hidden;
    min-height: 40px;
  }
  .vf-announcement__track {
    position: relative;
    width: 100%;
    min-height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vf-announcement__slide {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease-in-out;
    color: var(--vf-ann-text, #FFFFFF);
    text-decoration: none;
    width: 100%;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vf-announcement__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  a.vf-announcement__slide {
    cursor: pointer;
    transition: opacity 0.5s ease-in-out, color 0.2s ease;
  }
  a.vf-announcement__slide:hover {
    opacity: 0.85;
  }
  .vf-announcement__text {
    display: inline-block;
    max-width: 100%;
  }

  /* ===== Tarja de promo (urgência) ===== */
  .vf-announcement--promo {
    animation: vf-ann-pulse 1.6s ease-in-out infinite;
  }
  @keyframes vf-ann-pulse {
    0%, 100% { box-shadow: inset 0 0 0 0 rgba(255,255,255,0.18); }
    50% { box-shadow: inset 0 0 24px 0 rgba(255,255,255,0.18); }
  }
  .vf-announcement__text--promo {
    font-weight: 800;
    letter-spacing: 0.4px;
    white-space: normal;
  }
  .vf-ann-countdown {
    display: inline-block;
    background: rgba(255,255,255,0.22);
    padding: 2px 10px;
    border-radius: 6px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5px;
    margin-left: 2px;
  }

  @media (max-width: 540px) {
    .vf-announcement {
      font-size: 12.5px;
      padding: 9px 14px;
      letter-spacing: 0.2px;
      min-height: 36px;
    }
    .vf-announcement__text--promo { font-size: 12px; }
  }
{% endstylesheet %}

<script>
(function() {
  var bars = document.querySelectorAll('[data-vf-ann]');
  bars.forEach(function(bar) {
    var slides = bar.querySelectorAll('[data-slide]');
    if (slides.length < 2) return; // só rotaciona se tiver 2+

    var interval = parseInt(bar.dataset.interval, 10) || 5;
    var current = 0;

    setInterval(function() {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, interval * 1000);
  });

  /* ===== Contador regressivo da promo (usado na tarja e na página de produto) ===== */
  function pad(n) { return String(n).padStart(2, '0'); }

  var countdownEls = document.querySelectorAll('[data-countdown]');
  if (countdownEls.length) {
    var targets = [];
    countdownEls.forEach(function(el) {
      var t = new Date(el.dataset.countdown).getTime();
      if (!isNaN(t)) targets.push({ el: el, target: t });
    });

    function tickCountdowns() {
      var now = Date.now();
      targets.forEach(function(item) {
        var diff = item.target - now;
        if (diff <= 0) {
          item.el.textContent = '00:00:00';
          return;
        }
        var days = Math.floor(diff / 86400000);
        var hours = Math.floor((diff % 86400000) / 3600000);
        var mins = Math.floor((diff % 3600000) / 60000);
        var secs = Math.floor((diff % 60000) / 1000);
        item.el.textContent = days > 0
          ? days + 'd ' + pad(hours) + 'h ' + pad(mins) + 'm'
          : pad(hours) + ':' + pad(mins) + ':' + pad(secs);
      });
    }

    tickCountdowns();
    setInterval(tickCountdowns, 1000);
  }
})();
</script>

{% schema %}
{
  "name": "VF Tarja Anúncio",
  "tag": "section",
  "class": "vf-announcement-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "Mostrar tarja",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "promo_on",
      "label": "🔴 Modo promo: frete grátis sem mínimo",
      "info": "Ligado, a tarja fica vermelha anunciando frete grátis sem mínimo enquanto este tema estiver publicado. Desmarque para voltar às mensagens normais. O desconto em si é configurado em Descontos, não aqui.",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_end",
      "label": "Fim da promo (contador)",
      "info": "Formato 2026-09-07T00:00:00-03:00. Precisa bater com a data de fim do desconto em Descontos. Deixe em branco para anunciar sem contador.",
      "default": "2026-09-07T00:00:00-03:00"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo",
      "default": "#1B5E20"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Intervalo entre mensagens (segundos)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "🚚 FRETE GRÁTIS em pedidos acima de R$ 399"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link opcional"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "VF Tarja Anúncio",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "🚚 FRETE GRÁTIS em pedidos acima de R$ 399"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "🎟️ Use o cupom 5OFF e ganhe 5% de desconto"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "💳 PARCELAMENTO em até 10x"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "🌿 PROTOCOLO 100% FITOTERÁPICO"
          }
        }
      ]
    }
  ]
}
{% endschema %}
