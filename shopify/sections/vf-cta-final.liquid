{%- comment -%}
  VermeFree — CTA Final
  Faixa final full-width com headline gigante + botao.
  Imagem de fundo opcional.
{%- endcomment -%}

<section
  class="vf-cta{% if section.settings.background_image != blank %} vf-cta--has-image{% endif %}"
  style="--vf-cta-bg: {{ section.settings.background_color }}; --vf-cta-color: {{ section.settings.text_color }};"
  aria-labelledby="vf-cta-heading"
>
  {%- if section.settings.background_image != blank -%}
    <img
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      srcset="{{ section.settings.background_image | image_url: width: 1000 }} 1000w, {{ section.settings.background_image | image_url: width: 2000 }} 2000w"
      sizes="100vw"
      alt=""
      class="vf-cta__bg"
      loading="lazy"
    >
    <div class="vf-cta__overlay"></div>
  {%- endif -%}

  <div class="vf-cta__container">
    {%- if section.settings.heading != blank -%}
      <h2 id="vf-cta-heading" class="vf-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="vf-cta__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a
        href="{{ section.settings.button_link }}"
        class="vf-cta__btn"
        aria-label="{{ section.settings.button_label | escape }}"
      >
        {{ section.settings.button_label }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .vf-cta {
    position: relative;
    background: var(--vf-cta-bg, #5EBC43);
    color: var(--vf-cta-color, #FFFFFF);
    padding: clamp(64px, 10vw, 120px) 0;
    font-family: 'Inter', system-ui, sans-serif;
    overflow: hidden;
  }

  .vf-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    z-index: 0;
  }

  .vf-cta__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 1;
  }

  .vf-cta__container {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .vf-cta__heading {
    font-family: 'Caprasimo', Georgia, serif;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .vf-cta__sub {
    font-size: clamp(15px, 1.6vw, 19px);
    line-height: 1.5;
    margin: 0 0 12px 0;
    max-width: 580px;
    opacity: 0.95;
  }

  .vf-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    color: #009933;
    font-weight: 700;
    font-size: 16px;
    padding: 18px 36px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .vf-cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.18);
  }
  .vf-cta__btn span { transition: transform 0.2s ease; }
  .vf-cta__btn:hover span { transform: translateX(4px); }
{% endstylesheet %}

{% schema %}
{
  "name": "VF CTA Final",
  "tag": "section",
  "class": "vf-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Desparasite agora."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitulo",
      "default": "Frete pra todo Brasil. Parcelado em ate 3x sem juros."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botao",
      "default": "Garantir meu protocolo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botao (checkout direto do Adulto)",
      "info": "Use /products/SLUG-DO-ADULTO ou /cart/VARIANT_ID:1 para ir direto ao checkout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#5EBC43"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de fundo (opcional)"
    }
  ],
  "presets": [
    { "name": "VF CTA Final" }
  ]
}
{% endschema %}
