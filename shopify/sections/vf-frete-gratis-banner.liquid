{%- comment -%}
  vf-frete-gratis-banner — Banner de campanha na HOME
  Adaptado de vf-semana-cliente-banner (tema Semana do Cliente).

  Diferença da Semana do Cliente: lá o herói do bloco era o cupom pra copiar,
  porque o desconto só entrava se a pessoa digitasse SEMANA7. Aqui não existe
  código — então o lugar do cupom foi ocupado pelo que a promo realmente dá:
  o FRETE GRÁTIS e o MANUAL DA DESPARASITAÇÃO. "Sem cupom" virou nota de rodapé
  em vez de manchete: é ausência de fricção, não é o prêmio.

  O manual é e-book enviado por automação de e-mail — por isso a copy fala em
  "no seu e-mail depois da compra", e não em algo que vai dentro da caixa.

  Date-gated: 05/09 a 06/09/2026. Preview ligado por padrão, como no tema de
  campanha — quem acende/apaga a vitrine é a publicação do tema.

  ⚠️ A data de fim aqui precisa bater com a do desconto automático
  "Frete Grátis · Fim de Semana 05-06/09 (sem mínimo)" no Shopify. Se uma
  mudar e a outra não, o banner promete o que o checkout não cumpre.
{%- endcomment -%}

{%- assign fg_today = 'now' | date: '%Y-%m-%d' -%}
{%- assign fg_active = false -%}
{%- if fg_today >= '2026-09-05' and fg_today <= '2026-09-06' -%}
  {%- assign fg_active = true -%}
{%- endif -%}
{%- if section.settings.preview -%}
  {%- assign fg_active = true -%}
{%- endif -%}

{%- assign fg_end = section.settings.promo_end -%}

{%- if fg_active -%}
  <section class="vf-fg-banner" style="--fg-bg:{{ section.settings.bg_color | default: '#E11D2E' }};--fg-accent:{{ section.settings.accent_color | default: '#FFFFFF' }};">
    <div class="vf-fg-banner__inner">
      <span class="vf-fg-banner__eyebrow">{{ section.settings.eyebrow | default: '🚚 SÓ ESTE FIM DE SEMANA' }}</span>
      <h2 class="vf-fg-banner__title">{{ section.settings.heading | default: 'O frete é por nossa conta.' }}</h2>
      <p class="vf-fg-banner__sub">{{ section.settings.subheading | default: 'Sábado e domingo, seu protocolo chega sem custo de entrega — e com o manual pra fazer tudo no tempo certo.' }}</p>

      <div class="vf-fg-banner__itens">
        <div class="vf-fg-banner__item">
          <span class="vf-fg-banner__item-ic" aria-hidden="true">🚚</span>
          <span class="vf-fg-banner__item-tit">{{ section.settings.item1_titulo | default: 'Frete grátis' }}</span>
          <span class="vf-fg-banner__item-txt">{{ section.settings.item1_texto | default: 'Em qualquer pedido, sem valor mínimo, pra todo o Brasil' }}</span>
        </div>
        <div class="vf-fg-banner__item">
          <span class="vf-fg-banner__item-ic" aria-hidden="true">📘</span>
          <span class="vf-fg-banner__item-tit">{{ section.settings.item2_titulo | default: 'Manual da Desparasitação' }}</span>
          <span class="vf-fg-banner__item-txt">{{ section.settings.item2_texto | default: 'E-book com o passo a passo, no seu e-mail depois da compra' }}</span>
        </div>
      </div>

      <p class="vf-fg-banner__micro">{{ section.settings.micro | default: 'Sem cupom pra digitar: o frete já vem zerado e o manual chega no seu e-mail.' }}</p>

      {%- if section.settings.perk != blank -%}
        <p class="vf-fg-banner__perk">{{ section.settings.perk }}</p>
      {%- endif -%}

      {%- if fg_end != blank -%}
        <div class="vf-fg-banner__timer">
          Termina em <strong class="vf-fg-banner__countdown" data-fg-countdown="{{ fg_end }}">--h --m --s</strong>
        </div>
      {%- endif -%}

      <a class="vf-fg-banner__cta" href="{{ section.settings.cta_link | default: '#vf-kit-heading' }}">
        {{ section.settings.cta_label | default: 'Escolher meu protocolo' }}
      </a>
    </div>
  </section>

  <script>
  (function() {
    function pad(n){ return String(n).padStart(2,'0'); }
    document.querySelectorAll('.vf-fg-banner [data-fg-countdown]').forEach(function(el){
      var target = new Date(el.getAttribute('data-fg-countdown')).getTime();
      if (isNaN(target)) { el.style.display = 'none'; return; }
      function tick(){
        var diff = target - Date.now();
        if (diff <= 0){ el.textContent = '00h 00m 00s'; return; }
        var d = Math.floor(diff/86400000);
        var h = Math.floor((diff%86400000)/3600000);
        var m = Math.floor((diff%3600000)/60000);
        var s = Math.floor((diff%60000)/1000);
        el.textContent = d > 0 ? (d+'d '+pad(h)+'h '+pad(m)+'m') : (pad(h)+'h '+pad(m)+'m '+pad(s)+'s');
      }
      tick(); setInterval(tick, 1000);
    });
  })();
  </script>
{%- endif -%}

{% stylesheet %}
  .vf-fg-banner { background: var(--fg-bg, #E11D2E); color: #fff; padding: 38px 20px; text-align: center; font-family: 'Inter', system-ui, sans-serif; }
  .vf-fg-banner__inner { max-width: 760px; margin: 0 auto; }
  .vf-fg-banner__eyebrow { display: inline-block; font-weight: 800; letter-spacing: .14em; font-size: 12.5px; background: rgba(255,255,255,.18); padding: 6px 15px; border-radius: 999px; }
  .vf-fg-banner__title { font-size: 34px; line-height: 1.12; margin: 15px 0 8px; font-weight: 800; color: #fff; }
  .vf-fg-banner__sub { font-size: 16px; opacity: .94; margin: 0 auto 22px; max-width: 580px; color: #fff; }

  .vf-fg-banner__itens { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .vf-fg-banner__item { background: rgba(0,0,0,.16); border: 1px dashed rgba(255,255,255,.45); border-radius: 14px; padding: 18px 16px; display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .vf-fg-banner__item-ic { font-size: 30px; line-height: 1; }
  .vf-fg-banner__item-tit { font-size: 19px; font-weight: 800; letter-spacing: .01em; color: var(--fg-accent, #FFFFFF); line-height: 1.2; }
  .vf-fg-banner__item-txt { font-size: 13.5px; line-height: 1.4; opacity: .9; max-width: 260px; }

  .vf-fg-banner__micro { margin: 14px 0 0; font-size: 13.5px; opacity: .88; }
  .vf-fg-banner__perk { margin: 10px auto 0; font-size: 13.5px; line-height: 1.45; opacity: .88; max-width: 560px; }
  .vf-fg-banner__timer { margin-top: 20px; font-size: 15px; }
  .vf-fg-banner__countdown { display: inline-block; background: rgba(255,255,255,.2); padding: 4px 12px; border-radius: 8px; font-variant-numeric: tabular-nums; letter-spacing: .5px; margin-left: 4px; }
  .vf-fg-banner__cta { display: inline-block; margin-top: 20px; background: #fff; color: var(--fg-bg, #E11D2E); font-weight: 800; font-size: 16px; text-decoration: none; padding: 15px 36px; border-radius: 999px; transition: transform .15s ease, box-shadow .15s ease; }
  .vf-fg-banner__cta:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(0,0,0,.25); }

  @media (max-width: 600px) {
    .vf-fg-banner { padding: 28px 16px; }
    .vf-fg-banner__title { font-size: 25px; }
    .vf-fg-banner__sub { font-size: 14.5px; margin-bottom: 18px; }
    .vf-fg-banner__itens { grid-template-columns: 1fr; }
    .vf-fg-banner__item { padding: 15px 14px; }
    .vf-fg-banner__item-tit { font-size: 17.5px; }
    .vf-fg-banner__cta { display: block; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VF Banner Frete Grátis",
  "tag": "section",
  "class": "vf-fg-banner-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "preview",
      "label": "🚚 Forçar exibição (ligado — publicação agendada por app)",
      "info": "Ligado por padrão neste tema de campanha. A vitrine acende/apaga publicando/despublicando o tema pelo app.",
      "default": true
    },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "🚚 SÓ ESTE FIM DE SEMANA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "O frete é por nossa conta." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Sábado e domingo, seu protocolo chega sem custo de entrega — e com o manual pra fazer tudo no tempo certo." },
    { "type": "header", "content": "O que a promo dá" },
    { "type": "text", "id": "item1_titulo", "label": "Item 1 — título", "default": "Frete grátis" },
    { "type": "text", "id": "item1_texto", "label": "Item 1 — texto", "default": "Em qualquer pedido, sem valor mínimo, pra todo o Brasil" },
    { "type": "text", "id": "item2_titulo", "label": "Item 2 — título", "default": "Manual da Desparasitação" },
    { "type": "text", "id": "item2_texto", "label": "Item 2 — texto", "default": "E-book com o passo a passo, no seu e-mail depois da compra" },
    { "type": "text", "id": "micro", "label": "Linha de apoio", "info": "Aqui é o lugar de dizer que não precisa cupom — sem virar manchete.", "default": "Sem cupom pra digitar: o frete já vem zerado e o manual chega no seu e-mail." },
    { "type": "textarea", "id": "perk", "label": "Linha extra (opcional)", "default": "🌿 E ainda soma com o desconto por quantidade: 3 protocolos = 10% · 5 = 15% · 8 = 20%" },
    { "type": "header", "content": "Prazo e botão" },
    { "type": "text", "id": "promo_end", "label": "Fim da promo (contador)", "info": "Formato 2026-09-06T23:59:59-03:00. Precisa bater com a data de fim do desconto em Descontos. Em branco, some o contador.", "default": "2026-09-06T23:59:59-03:00" },
    { "type": "text", "id": "cta_label", "label": "Texto do botão", "default": "Escolher meu protocolo" },
    { "type": "text", "id": "cta_link", "label": "Link do botão", "default": "#vf-kit-heading" },
    { "type": "header", "content": "Cores" },
    { "type": "color", "id": "bg_color", "label": "Cor de fundo", "default": "#E11D2E" },
    { "type": "color", "id": "accent_color", "label": "Cor dos títulos dos itens", "default": "#FFFFFF" }
  ],
  "presets": [ { "name": "VF Banner Frete Grátis" } ]
}
{% endschema %}
