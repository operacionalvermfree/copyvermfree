{%- comment -%}
  vf-promo-frete-bloco — Bloco grande da promo FRETE GRÁTIS SEM MÍNIMO.
  Mesma ideia do bloco da Semana do Cliente, sem a parte de cupom: aqui não
  tem código pra copiar, porque o frete zera sozinho no checkout.

  Adicione pelo editor (Home > Adicionar seção > "VF Promo Frete Grátis").
  Os benefícios vêm do snippet vf-promo-frete — mexer no texto lá reflete aqui,
  na faixa da PDP e na caixa do botão de comprar, tudo junto.

  O contador usa "Fim da promo". Em branco, o bloco aparece sem contador —
  melhor assim do que com data vencida, que trava em 00:00:00.
{%- endcomment -%}

{%- assign pf_fim = section.settings.promo_end -%}

<section class="vf-pfb" style="--vf-pfb-bg: {{ section.settings.background_color | default: '#1B5E20' }};" aria-labelledby="vf-pfb-title">
  <div class="vf-pfb__wrap">
    <span class="vf-pfb__pill">🚚 Frete grátis sem mínimo</span>

    {%- if section.settings.heading != blank -%}
      <h2 class="vf-pfb__title" id="vf-pfb-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="vf-pfb__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {% render 'vf-promo-frete', variante: 'beneficios' %}

    {%- if pf_fim != blank -%}
      <div class="vf-pfb__timer" data-pfb-timer data-fim="{{ pf_fim }}">
        <div class="vf-pfb__unit"><span class="vf-pfb__num" data-h>--</span><span class="vf-pfb__lbl">horas</span></div>
        <span class="vf-pfb__sep">:</span>
        <div class="vf-pfb__unit"><span class="vf-pfb__num" data-m>--</span><span class="vf-pfb__lbl">min</span></div>
        <span class="vf-pfb__sep">:</span>
        <div class="vf-pfb__unit"><span class="vf-pfb__num" data-s>--</span><span class="vf-pfb__lbl">seg</span></div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="vf-pfb__btn">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .vf-pfb{ background:var(--vf-pfb-bg,#1B5E20); padding:clamp(48px,7vw,80px) 20px; font-family:'Inter',system-ui,sans-serif; }
  .vf-pfb__wrap{ max-width:720px; margin:0 auto; display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center; }
  .vf-pfb__pill{ display:inline-flex; align-items:center; gap:7px; background:rgba(255,255,255,.16); color:#fff; font-size:11.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; padding:6px 16px; border-radius:999px; }
  .vf-pfb__title{ font-family:'Caprasimo',Georgia,serif; font-size:clamp(28px,4.6vw,42px); line-height:1.12; margin:0; color:#0F2A12; letter-spacing:-.01em; }
  .vf-pfb__sub{ margin:0; font-size:clamp(14px,1.7vw,16px); line-height:1.55; color:#EAF4E2; max-width:560px; }
  .vf-pfb .vf-pf-benef{ width:100%; margin-top:4px; }

  .vf-pfb__timer{ display:flex; align-items:center; gap:8px; margin-top:6px; }
  .vf-pfb__unit{ background:rgba(255,255,255,.13); border-radius:10px; padding:10px 16px; min-width:74px; display:flex; flex-direction:column; align-items:center; gap:2px; }
  .vf-pfb__num{ font-family:'Caprasimo',Georgia,serif; font-size:clamp(24px,3.4vw,32px); line-height:1; color:#fff; font-variant-numeric:tabular-nums; }
  .vf-pfb__lbl{ font-size:9.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#C0DE96; }
  .vf-pfb__sep{ color:rgba(255,255,255,.45); font-size:22px; font-weight:800; }

  .vf-pfb__btn{ margin-top:10px; display:inline-flex; align-items:center; justify-content:center; background:#fff; color:#1B5E20; font-weight:800; font-size:16px; padding:16px 38px; border-radius:999px; text-decoration:none; transition:transform .18s ease, box-shadow .18s ease; }
  .vf-pfb__btn:hover{ transform:translateY(-2px); box-shadow:0 10px 26px rgba(0,0,0,.22); }

  @media (max-width:540px){
    .vf-pfb__unit{ min-width:60px; padding:9px 11px; }
    .vf-pfb__btn{ width:100%; padding:15px 20px; }
  }
{% endstylesheet %}

<script>
(function(){
  document.querySelectorAll('[data-pfb-timer]').forEach(function(box){
    var alvo = new Date(box.dataset.fim).getTime();
    if (isNaN(alvo)) { box.hidden = true; return; }
    var h = box.querySelector('[data-h]'), m = box.querySelector('[data-m]'), s = box.querySelector('[data-s]');
    function pad(n){ return String(n).padStart(2,'0'); }
    function tick(){
      var d = alvo - Date.now();
      if (d <= 0) { h.textContent = m.textContent = s.textContent = '00'; return; }
      h.textContent = pad(Math.floor(d/3600000));
      m.textContent = pad(Math.floor((d%3600000)/60000));
      s.textContent = pad(Math.floor((d%60000)/1000));
    }
    tick(); setInterval(tick, 1000);
  });
})();
</script>

{% schema %}
{
  "name": "VF Promo Frete Grátis",
  "tag": "section",
  "class": "vf-pfb-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Frete grátis, sem valor mínimo."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Não precisa juntar pedido nem digitar cupom. O frete zera sozinho no checkout, pra todo o Brasil."
    },
    {
      "type": "text",
      "id": "promo_end",
      "label": "Fim da promo (contador)",
      "info": "Formato 2026-09-07T00:00:00-03:00. Precisa bater com a data de fim do desconto em Descontos. Deixe em branco para aparecer sem contador.",
      "default": "2026-09-07T00:00:00-03:00"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Escolher meu protocolo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#1B5E20"
    }
  ],
  "presets": [
    { "name": "VF Promo Frete Grátis" }
  ]
}
{% endschema %}
