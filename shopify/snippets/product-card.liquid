{%- comment -%}
  product-card.liquid
  Card padronizado de produto (coleções, busca, listas).
  Parâmetros:
   product (obj) — obrigatório
   show_vendor (bool) — default true
{%- endcomment -%}

{%- liquid
  assign show_vendor = show_vendor | default: true
  assign featured = product.featured_image
-%}

<article class="vf-product-card" data-product-card>
  <a href="{{ product.url }}" class="vf-product-card__image-link" aria-label="{{ product.title | escape }}">
    <div class="vf-product-card__image">
      {%- if featured -%}
        <img
          src="{{ featured | image_url: width: 600 }}"
          alt="{{ featured.alt | escape | default: product.title }}"
          width="600"
          height="600"
          loading="lazy"
          decoding="async">
      {%- else -%}
        <div class="vf-product-card__placeholder" aria-hidden="true">VF</div>
      {%- endif -%}
      {%- if product.compare_at_price > product.price -%}
        {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="vf-product-card__badge">-{{ discount_pct }}%</span>
      {%- endif -%}
    </div>
  </a>

  <div class="vf-product-card__body">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="vf-product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <h3 class="vf-product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="vf-product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="vf-product-card__compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
      <span class="vf-product-card__current">{{ product.price | money }}</span>
    </div>

    <a href="{{ product.url }}" class="vf-button vf-button--primary vf-button--sm vf-product-card__cta">
      Ver produto
    </a>
  </div>
</article>

<style>
  .vf-product-card {
    display: flex;
    flex-direction: column;
    background: var(--vf-surface);
    border-radius: var(--card-radius);
    border: 1px solid var(--vf-border);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .vf-product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .vf-product-card__image-link { display: block; }
  .vf-product-card__image {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--vf-beige);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .vf-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 16px;
    transition: transform .4s ease;
  }
  .vf-product-card:hover .vf-product-card__image img {
    transform: scale(1.04);
  }
  .vf-product-card__placeholder {
    font-family: var(--font-heading);
    font-size: 48px;
    color: var(--vf-green-dark);
    opacity: .3;
  }
  .vf-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    background: var(--vf-green);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    border-radius: 999px;
  }
  .vf-product-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .vf-product-card__vendor {
    font-size: 12px;
    color: var(--vf-muted);
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .vf-product-card__title {
    font-family: var(--font-heading);
    font-size: 20px;
    margin: 0;
    line-height: 1.2;
  }
  .vf-product-card__title a { color: inherit; }
  .vf-product-card__title a:hover { color: var(--vf-green-dark); }
  .vf-product-card__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
  }
  .vf-product-card__current {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--vf-text);
  }
  .vf-product-card__compare {
    color: var(--vf-muted);
    text-decoration: line-through;
    font-size: 14px;
  }
  .vf-product-card__cta {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
