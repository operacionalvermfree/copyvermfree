{%- comment -%}
  vf-promo-frete-pdp.liquid — Encaixa a caixa da promo logo acima do botão
  de comprar, na página de produto.

  POR QUE VIA JS: o sections/vf-pdp-main.liquid tem 85 KB e a API de tema só
  grava arquivo inteiro — reescrever tudo pra inserir 3 linhas é risco alto
  por ganho nenhum. Aqui o alvo é o form padrão de carrinho do Shopify
  (form[action*="/cart/add"]), que existe em qualquer tema e não depende das
  classes internas da PDP.

  Se o form não for encontrado, nada acontece: não quebra layout, só não
  aparece. Vale conferir no preview se a caixa apareceu mesmo.

  O conteúdo vem do <template> abaixo, renderizado por vf-promo-frete —
  então PROMO_ON lá desliga isto junto. Sem template, o script não faz nada.
{%- endcomment -%}

<template data-vf-pf-tpl>{% render 'vf-promo-frete', variante: 'caixa' %}</template>

<script>
(function () {
  var tpl = document.querySelector('[data-vf-pf-tpl]');
  if (!tpl || !tpl.content || !tpl.content.firstElementChild) return;

  function encaixar() {
    var forms = document.querySelectorAll('form[action*="/cart/add"]');
    if (!forms.length) return false;
    var achou = false;

    forms.forEach(function (form) {
      if (form.querySelector('[data-vf-pf-posto]')) return;
      // ancora no botao de submit; sem ele, no fim do proprio form
      var btn = form.querySelector('[type="submit"]');
      var no = tpl.content.firstElementChild.cloneNode(true);
      no.setAttribute('data-vf-pf-posto', '');
      no.style.margin = '0 0 12px';
      if (btn && btn.parentNode) { btn.parentNode.insertBefore(no, btn); }
      else { form.appendChild(no); }
      achou = true;
    });
    return achou;
  }

  if (!encaixar()) {
    // PDPs que montam o form depois (variante, kit selector) — observa e desiste em 10s
    var obs = new MutationObserver(function () { if (encaixar()) parar(); });
    function parar() { obs.disconnect(); clearTimeout(limite); }
    obs.observe(document.body, { childList: true, subtree: true });
    var limite = setTimeout(parar, 10000);
  }
})();
</script>
