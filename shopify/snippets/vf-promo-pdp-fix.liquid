{%- comment -%}
  vf-promo-pdp-fix.liquid — Contador da promo na PDP.

  POR QUE ISTO EXISTE: o script que anima [data-countdown] mora na tarja de
  anúncio, no topo do <body>, e roda enquanto a página ainda está sendo lida.
  A PDP ainda não existe no DOM nesse momento, então ele nunca acha o elemento
  e o contador fica travado em "--:--:--". Aqui o contador da PDP é assumido
  por conta própria, depois do DOM pronto.

  Era um snippet maior: também corrigia a barra de kits, a tarja "FRETE GRÁTIS
  HOJE", a linha "só hoje e amanhã", o visual vermelho dos cards e a parcela
  que divergia em 1 centavo. Tudo isso agora está no próprio
  sections/vf-pdp-main.liquid, então saiu daqui — só o contador continua
  precisando de ponte, porque o problema é ordem de execução, não conteúdo.

  Quando a promo acabar: PROMO_ON = false desliga o snippet inteiro.
{%- endcomment -%}

{%- assign PROMO_ON = true -%}
{%- assign PROMO_FIM = '2026-09-07T00:00:00-03:00' -%}

{%- if PROMO_ON -%}
<script>
(function () {
  var FIM = '{{ PROMO_FIM }}';

  function pad(n) { return String(n).padStart(2, '0'); }

  function pronto(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  pronto(function () {
    var bloco = document.querySelector('.vf-pdp__frete-promo');
    if (!bloco) return;

    var alvoEl = bloco.querySelector('[data-countdown]');
    if (!alvoEl) return;

    /* tira do controle do script da tarja, que roda cedo demais e nao pega isto */
    alvoEl.removeAttribute('data-countdown');

    var alvo = new Date(FIM).getTime();
    if (isNaN(alvo)) { alvoEl.textContent = ''; return; }

    function tick() {
      var d = alvo - Date.now();
      if (d <= 0) { bloco.hidden = true; return; }
      var dias = Math.floor(d / 86400000);
      var h = Math.floor((d % 86400000) / 3600000);
      var m = Math.floor((d % 3600000) / 60000);
      var s = Math.floor((d % 60000) / 1000);
      alvoEl.textContent = dias > 0
        ? dias + 'd ' + pad(h) + 'h ' + pad(m) + 'm'
        : pad(h) + ':' + pad(m) + ':' + pad(s);
    }
    tick();
    setInterval(tick, 1000);
  });
})();
</script>
{%- endif -%}
